{
  "name": "siyana-debt-tracker",
  "version": "1.0.0",
  "description": "A private, offline-first mobile app to record what you lend and borrow, and never forget a payment again.",
  "keywords": [
    "debt",
    "tracker",
    "ledger",
    "offline",
    "finance",
    "expo",
    "react-native",
    "sqlite",
    "siyana-code"
  ],
  "homepage": "https://github.com/siyana-code/Siyana-Debt-Tracker#readme",
  "bugs": {
    "url": "https://github.com/siyana-code/Siyana-Debt-Tracker/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/siyana-code/Siyana-Debt-Tracker.git"
  },
  "license": "MIT",
  "author": "Rasindu Appuhami",
  "main": "expo-router/entry",
  "private": true,
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "prebuild": "expo prebuild",
    "icons": "powershell -ExecutionPolicy Bypass -File ./scripts/generate-icons.ps1",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "node --test tests/money.test.ts tests/date.test.ts tests/debt.test.ts tests/migrations.test.ts"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "expo": "~57.0.28",
    "expo-constants": "~57.0.22",
    "expo-file-system": "~57.0.7",
    "expo-linking": "~57.0.13",
    "expo-router": "~57.0.27",
    "expo-sharing": "~57.0.23",
    "expo-splash-screen": "~57.0.10",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
